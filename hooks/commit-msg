#!/bin/sh
# Workbench commit message gate of this repository (the working copy of the public repository). The message of a
# commit is checked at the push (hooks/pre-push), so this hook runs no content check: the gate with --inside
# refuses only a message that names an assistant as co-author or generator. Comment lines and everything after the
# scissors line are not part of the message. Install with: git config core.hooksPath hooks

msg="$1"
top=$(git rev-parse --show-toplevel) || exit 2
python="$top/.venv/bin/python"

if [ ! -x "$python" ]; then
    echo "awb gate: commit refused, this repository has no .venv/bin/python to run the gate." >&2
    exit 2
fi

cd "$top" || exit 2
if ! "$python" -m awb.gate --selftest >/dev/null 2>&1; then
    echo "awb gate: commit refused, the gate failed its self-test and cannot be trusted to find anything." >&2
    exit 1
fi
"$python" -m awb.gate --message "$msg" --inside
code=$?

if [ "$code" -ne 0 ]; then
    echo "awb gate: commit refused (exit code $code), the commit message names an assistant as co-author." >&2
    echo "awb gate: remove that line from the message and commit again." >&2
fi
exit "$code"
