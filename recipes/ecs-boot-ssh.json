{
  "name": "ecs-boot-ssh",
  "question": "Does an ECS of flavor ${flavor} boot the image ${image} in ${region} and answer on SSH port 22 inside its VPC (security group rule, no EIP)?",
  "about": "A VPC with a subnet, a security group that lets TCP 22 in from the subnet only, the server under test and a probe server in the same subnet. The probe tries port 22 of the server under test and writes AWB-SSH-OPEN or AWB-SSH-CLOSED to its console; the check reads the console output. No EIP: nothing is reachable from outside.",
  "params": {
    "flavor": {"default": "s3.medium.1", "pattern": "^(s2|s3|c4|m3|t2)\\.(medium|large|xlarge|2xlarge)\\.[1248]$",
               "help": "the flavor under test; the pattern keeps it to general and compute sizes up to 2xlarge"},
    "image": {"default": "Standard_Ubuntu_22.04_latest", "pattern": "^[A-Za-z0-9_.-]{3,80}$",
              "help": "the name of a public image; the probe needs a Linux image with bash"},
    "region": {"default": "eu-de", "pattern": "^eu-(de|nl)$"},
    "az": {"default": "eu-de-01", "pattern": "^eu-(de|nl)-0[1-3]$"},
    "probe_flavor": {"default": "s3.medium.1", "pattern": "^s3\\.medium\\.[12]$"},
    "admin_secret": {"default": "ecs-admin", "pattern": "^[a-z0-9][a-z0-9_.-]{0,40}$",
                     "help": "the name of the tenant secret that fills adminPass (awb cloud tenants lists the names)"}
  },
  "vars": {
    "cidr": "192.168.10.0/24",
    "probe_script": "#!/bin/bash\nfor i in $(seq 1 30); do\n  if timeout 3 bash -c '</dev/tcp/${server_ip}/22'; then echo AWB-SSH-OPEN | tee /dev/console /dev/ttyS0; exit 0; fi\n  sleep 10\ndone\necho AWB-SSH-CLOSED | tee /dev/console /dev/ttyS0\n"
  },
  "budget": {"minutes": 30, "teardown_minutes": 10},
  "guard": {"resources": 5, "lifetime_minutes": 45},
  "steps": [
    {"id": "image", "do": "call", "says": "find the public image by its name",
     "call": {"method": "GET", "service": "ims", "path": "/v2/cloudimages",
              "query": {"name": "${image}", "__imagetype": "gold", "limit": "1"}},
     "save": {"image_id": "images.0.id"},
     "confirm": "the name and __imagetype=gold filters of GET /v2/cloudimages (the repository reads it with __imagetype=private only)"},
    {"id": "vpc", "do": "create", "says": "a VPC",
     "call": {"method": "POST", "service": "vpc", "path": "/v1/{project_id}/vpcs",
              "body": {"vpc": {"name": "${name}", "cidr": "192.168.0.0/16"}}},
     "id_field": "vpc.id",
     "resource": {"kind": "vpc", "type": "vpc", "cost": "none"},
     "tags": {"method": "POST", "service": "vpc", "path": "/v2.0/{project_id}/vpcs/${id}/tags/action",
              "body": {"action": "create", "tags": "${tags:kv}"}},
     "confirm": "the tag call POST /v2.0/{project_id}/vpcs/ID/tags/action and its body"},
    {"id": "subnet", "do": "create", "says": "a subnet in the VPC",
     "call": {"method": "POST", "service": "vpc", "path": "/v1/{project_id}/subnets",
              "body": {"subnet": {"name": "${name}", "cidr": "${cidr}", "gateway_ip": "192.168.10.1",
                                  "vpc_id": "${vpc}", "availability_zone": "${az}"}}},
     "id_field": "subnet.id",
     "resource": {"kind": "sub", "type": "vpc subnet", "cost": "none"},
     "tags": "name"},
    {"id": "subnet-active", "do": "wait", "says": "the subnet is ACTIVE",
     "call": {"method": "GET", "service": "vpc", "path": "/v1/{project_id}/subnets/${subnet}"},
     "until": {"field": "subnet.status", "equals": "ACTIVE"}, "fail_on": ["ERROR"], "within": 90, "every": 5},
    {"id": "sg", "do": "create", "says": "a security group in the VPC",
     "call": {"method": "POST", "service": "vpc", "path": "/v1/{project_id}/security-groups",
              "body": {"security_group": {"name": "${name}", "vpc_id": "${vpc}"}}},
     "id_field": "security_group.id",
     "resource": {"kind": "sg", "type": "security group", "cost": "none"},
     "tags": "name",
     "confirm": "POST /v1/{project_id}/security-groups and the id under security_group.id"},
    {"id": "sg-rule", "do": "call", "says": "let TCP 22 in from the subnet only",
     "call": {"method": "POST", "service": "vpc", "path": "/v1/{project_id}/security-group-rules",
              "body": {"security_group_rule": {"security_group_id": "${sg}", "direction": "ingress",
                                               "ethertype": "IPv4", "protocol": "tcp", "port_range_min": 22,
                                               "port_range_max": 22, "remote_ip_prefix": "${cidr}"}}},
     "confirm": "POST /v1/{project_id}/security-group-rules; the rule goes with its group"},
    {"id": "server", "do": "create", "says": "the server under test",
     "call": {"method": "POST", "service": "ecs", "path": "/v1/{project_id}/cloudservers",
              "body": {"server": {"name": "${name}-a", "imageRef": "${image_id}", "flavorRef": "${flavor}",
                                  "vpcid": "${vpc}", "nics": [{"subnet_id": "${subnet}"}],
                                  "security_groups": [{"id": "${sg}"}], "root_volume": {"volumetype": "SATA"},
                                  "availability_zone": "${az}", "adminPass": "{{secret:${admin_secret}}}",
                                  "server_tags": "${tags:kv}", "count": 1}}},
     "id_field": "serverIds.0",
     "find": {"call": {"method": "GET", "service": "ecs", "path": "/v1/{project_id}/cloudservers/detail",
                       "query": {"name": "${name}-a"}},
              "field": "servers.0.id", "within": 120},
     "resource": {"kind": "ecs", "type": "ecs server with its system disk", "cost": "small"},
     "tags": "body",
     "confirm": "the create body (vpcid, nics, root_volume, server_tags) and whether the answer carries serverIds or a job_id only; find reads the id by name when it does not"},
    {"id": "boot", "do": "wait", "says": "the server under test boots",
     "call": {"method": "GET", "service": "ecs", "path": "/v1/{project_id}/cloudservers/${server}"},
     "until": {"field": "server.status", "equals": "ACTIVE"}, "fail_on": ["ERROR"], "within": 600, "every": 10,
     "save": {"server_ip": "server.addresses.${vpc}.0.addr"},
     "confirm": "GET /v1/{project_id}/cloudservers/ID and the address under server.addresses.VPC_ID.0.addr"},
    {"id": "probe", "do": "create", "says": "a probe server in the same subnet that tries port 22",
     "call": {"method": "POST", "service": "ecs", "path": "/v1/{project_id}/cloudservers",
              "body": {"server": {"name": "${name}-p", "imageRef": "${image_id}", "flavorRef": "${probe_flavor}",
                                  "vpcid": "${vpc}", "nics": [{"subnet_id": "${subnet}"}],
                                  "security_groups": [{"id": "${sg}"}], "root_volume": {"volumetype": "SATA"},
                                  "availability_zone": "${az}", "adminPass": "{{secret:${admin_secret}}}",
                                  "user_data": "${base64:probe_script}", "server_tags": "${tags:kv}",
                                  "count": 1}}},
     "id_field": "serverIds.0",
     "find": {"call": {"method": "GET", "service": "ecs", "path": "/v1/{project_id}/cloudservers/detail",
                       "query": {"name": "${name}-p"}},
              "field": "servers.0.id", "within": 120},
     "resource": {"kind": "ecs", "type": "ecs probe server with its system disk", "cost": "small"},
     "tags": "body",
     "confirm": "user_data as base64 of a bash script and its run at first boot"},
    {"id": "console", "do": "wait", "says": "the probe writes its answer to the console",
     "call": {"method": "POST", "service": "ecs", "path": "/v2.1/{project_id}/servers/${probe}/action",
              "body": {"os-getConsoleOutput": {"length": 200}}},
     "until": {"field": "output", "contains": "AWB-SSH-"}, "within": 900, "every": 20,
     "confirm": "POST /v2.1/{project_id}/servers/ID/action with os-getConsoleOutput and the text under output; the lab key writes, so the read of the console goes as a POST"}
  ],
  "checks": [
    {"id": "image-known", "step": "image", "says": "the image is known in the region", "field": "images.0.id", "present": true},
    {"id": "boots", "step": "boot", "says": "the server under test reaches ACTIVE within 10 minutes", "reached": true},
    {"id": "ssh-answers", "step": "console", "says": "port 22 of the server under test answers inside the VPC", "field": "output", "contains": "AWB-SSH-OPEN"}
  ],
  "teardown": {
    "vpc": {"call": {"method": "DELETE", "service": "vpc", "path": "/v1/{project_id}/vpcs/${id}"},
            "gone": {"call": {"method": "GET", "service": "vpc", "path": "/v1/{project_id}/vpcs/${id}"}, "status": [404]}},
    "subnet": {"call": {"method": "DELETE", "service": "vpc", "path": "/v1/{project_id}/vpcs/${vpc}/subnets/${id}"},
               "gone": {"call": {"method": "GET", "service": "vpc", "path": "/v1/{project_id}/subnets/${id}"}, "status": [404]}},
    "sg": {"call": {"method": "DELETE", "service": "vpc", "path": "/v1/{project_id}/security-groups/${id}"},
           "gone": {"call": {"method": "GET", "service": "vpc", "path": "/v1/{project_id}/security-groups/${id}"}, "status": [404]},
           "confirm": "DELETE and GET /v1/{project_id}/security-groups/ID"},
    "server": {"call": {"method": "POST", "service": "ecs", "path": "/v1/{project_id}/cloudservers/delete",
                        "body": {"servers": [{"id": "${id}"}], "delete_publicip": true, "delete_volume": true}},
               "gone": {"call": {"method": "GET", "service": "ecs", "path": "/v1/{project_id}/cloudservers/${id}"},
                        "status": [404], "field": "server.status", "in": ["DELETED"], "within": 300},
               "confirm": "POST /v1/{project_id}/cloudservers/delete with delete_volume; a deleted server may read as DELETED for a while before 404"},
    "probe": {"call": {"method": "POST", "service": "ecs", "path": "/v1/{project_id}/cloudservers/delete",
                       "body": {"servers": [{"id": "${id}"}], "delete_publicip": true, "delete_volume": true}},
              "gone": {"call": {"method": "GET", "service": "ecs", "path": "/v1/{project_id}/cloudservers/${id}"},
                       "status": [404], "field": "server.status", "in": ["DELETED"], "within": 300},
              "confirm": "as for the server under test"}
  },
  "kb": {"scope": "tcp", "tags": ["ecs", "ims", "vpc"], "class": "availability",
         "statement": "An ECS of flavor ${flavor} boots the public image ${image} in ${region} and answers on TCP port 22 inside its VPC when a security group rule lets port 22 in from the subnet; no EIP is needed for that."}
}
