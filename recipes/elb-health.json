{
  "name": "elb-health",
  "question": "Does a shared ELB in ${region} with an ${protocol} listener on port ${port} and one ECS backend pass its ${protocol} health check?",
  "about": "A VPC with a subnet, a security group that lets the port in from the subnet and from the address range of the ELB health checks, one backend server that serves the port with python3 at first boot, a shared load balancer with a listener, a pool, the backend as its member and a health monitor. The check: the member reads ONLINE within 5 minutes.",
  "params": {
    "protocol": {"default": "HTTP", "choices": {"HTTP": {"hm_type": "HTTP"}, "TCP": {"hm_type": "TCP"}}},
    "port": {"default": "80", "pattern": "^(80|8080)$"},
    "image": {"default": "Standard_Ubuntu_22.04_latest", "pattern": "^[A-Za-z0-9_.-]{3,80}$"},
    "flavor": {"default": "s3.medium.1", "pattern": "^s3\\.medium\\.[12]$"},
    "region": {"default": "eu-de", "pattern": "^eu-(de|nl)$"},
    "az": {"default": "eu-de-01", "pattern": "^eu-(de|nl)-0[1-3]$"},
    "hc_source": {"default": "100.125.0.0/16", "pattern": "^[0-9./]{9,18}$",
                  "help": "the address range the health checks of a shared ELB come from"},
    "admin_secret": {"default": "ecs-admin", "pattern": "^[a-z0-9][a-z0-9_.-]{0,40}$"}
  },
  "vars": {
    "cidr": "192.168.10.0/24",
    "web_script": "#!/bin/bash\nmkdir -p /srv/awb && echo awb-lab > /srv/awb/index.html\ncd /srv/awb && nohup python3 -m http.server ${port} >/dev/null 2>&1 &\n"
  },
  "budget": {"minutes": 40, "teardown_minutes": 15},
  "guard": {"resources": 9, "lifetime_minutes": 60},
  "steps": [
    {"id": "image", "do": "call", "says": "find the public image by its name",
     "call": {"method": "GET", "service": "ims", "path": "/v2/cloudimages",
              "query": {"name": "${image}", "__imagetype": "gold", "limit": "1"}},
     "save": {"image_id": "images.0.id"},
     "confirm": "the name and __imagetype=gold filters of GET /v2/cloudimages"},
    {"id": "vpc", "do": "create", "says": "a VPC",
     "call": {"method": "POST", "service": "vpc", "path": "/v1/{project_id}/vpcs",
              "body": {"vpc": {"name": "${name}", "cidr": "192.168.0.0/16"}}},
     "id_field": "vpc.id",
     "name": "${name}",
     "find": {"call": {"method": "GET", "service": "vpc", "path": "/v1/{project_id}/vpcs", "query": {"limit": "100"}},
              "list": "vpcs", "field": "id", "within": 60},
     "resource": {"kind": "vpc", "type": "vpc", "cost": "none"},
     "tags": {"method": "POST", "service": "vpc", "path": "/v2.0/{project_id}/vpcs/${id}/tags/action",
              "body": {"action": "create", "tags": "${tags:kv}"}},
     "confirm": "the tag call POST /v2.0/{project_id}/vpcs/ID/tags/action and its body; the find GET /v1/{project_id}/vpcs reads one page of 100 and matches the name in the answer (the v1 list takes no name filter)"},
    {"id": "subnet", "do": "create", "says": "a subnet in the VPC",
     "call": {"method": "POST", "service": "vpc", "path": "/v1/{project_id}/subnets",
              "body": {"subnet": {"name": "${name}", "cidr": "${cidr}", "gateway_ip": "192.168.10.1",
                                  "vpc_id": "${vpc}", "availability_zone": "${az}"}}},
     "id_field": "subnet.id",
     "name": "${name}",
     "find": {"call": {"method": "GET", "service": "vpc", "path": "/v1/{project_id}/subnets", "query": {"vpc_id": "${vpc}"}},
              "list": "subnets", "field": "id", "within": 60},
     "resource": {"kind": "sub", "type": "vpc subnet", "cost": "none"},
     "tags": "name",
     "confirm": "the find GET /v1/{project_id}/subnets with the vpc_id filter and the list under subnets"},
    {"id": "subnet-active", "do": "wait", "says": "the subnet is ACTIVE",
     "call": {"method": "GET", "service": "vpc", "path": "/v1/{project_id}/subnets/${subnet}"},
     "until": {"field": "subnet.status", "equals": "ACTIVE"}, "fail_on": ["ERROR"], "within": 90, "every": 5,
     "save": {"neutron_subnet": "subnet.neutron_subnet_id"}},
    {"id": "sg", "do": "create", "says": "a security group for the backend",
     "call": {"method": "POST", "service": "vpc", "path": "/v1/{project_id}/security-groups",
              "body": {"security_group": {"name": "${name}", "vpc_id": "${vpc}"}}},
     "id_field": "security_group.id",
     "name": "${name}",
     "find": {"call": {"method": "GET", "service": "vpc", "path": "/v1/{project_id}/security-groups", "query": {"vpc_id": "${vpc}"}},
              "list": "security_groups", "field": "id", "within": 60},
     "resource": {"kind": "sg", "type": "security group", "cost": "none"},
     "tags": "name",
     "confirm": "POST /v1/{project_id}/security-groups and the id under security_group.id; the find GET /v1/{project_id}/security-groups with the vpc_id filter and the list under security_groups"},
    {"id": "sg-subnet", "do": "call", "says": "let the port in from the subnet",
     "call": {"method": "POST", "service": "vpc", "path": "/v1/{project_id}/security-group-rules",
              "body": {"security_group_rule": {"security_group_id": "${sg}", "direction": "ingress",
                                               "ethertype": "IPv4", "protocol": "tcp", "port_range_min": "${int:port}",
                                               "port_range_max": "${int:port}", "remote_ip_prefix": "${cidr}"}}},
     "confirm": "POST /v1/{project_id}/security-group-rules"},
    {"id": "sg-checks", "do": "call", "says": "let the port in from the health checks of the ELB",
     "call": {"method": "POST", "service": "vpc", "path": "/v1/{project_id}/security-group-rules",
              "body": {"security_group_rule": {"security_group_id": "${sg}", "direction": "ingress",
                                               "ethertype": "IPv4", "protocol": "tcp", "port_range_min": "${int:port}",
                                               "port_range_max": "${int:port}", "remote_ip_prefix": "${hc_source}"}}},
     "confirm": "the source range of the health checks of a shared ELB"},
    {"id": "backend", "do": "create", "says": "the backend server, serving the port at first boot",
     "call": {"method": "POST", "service": "ecs", "path": "/v1/{project_id}/cloudservers",
              "body": {"server": {"name": "${name}-b", "imageRef": "${image_id}", "flavorRef": "${flavor}",
                                  "vpcid": "${vpc}", "nics": [{"subnet_id": "${subnet}"}],
                                  "security_groups": [{"id": "${sg}"}], "root_volume": {"volumetype": "SATA"},
                                  "availability_zone": "${az}", "adminPass": "{{secret:${admin_secret}}}",
                                  "user_data": "${base64:web_script}", "server_tags": "${tags:kv}", "count": 1}}},
     "id_field": "serverIds.0",
     "find": {"call": {"method": "GET", "service": "ecs", "path": "/v1/{project_id}/cloudservers/detail",
                       "query": {"name": "${name}-b"}},
              "list": "servers", "field": "id", "within": 120},
     "name": "${name}-b",
     "resource": {"kind": "ecs", "type": "ecs backend server with its system disk", "cost": "small"},
     "tags": "body",
     "confirm": "the create body and its answer (serverIds or a job_id only), as in ecs-boot-ssh; whether user_data still runs with adminPass set (the ECS docs call adminPass invalid on a Cloud-Init image when user_data is given)"},
    {"id": "boot", "do": "wait", "says": "the backend boots",
     "call": {"method": "GET", "service": "ecs", "path": "/v1/{project_id}/cloudservers/${backend}"},
     "until": {"field": "server.status", "equals": "ACTIVE"}, "fail_on": ["ERROR"], "within": 600, "every": 10,
     "save": {"backend_ip": "server.addresses.${vpc}.0.addr"},
     "confirm": "the address under server.addresses.VPC_ID.0.addr"},
    {"id": "lb", "do": "create", "says": "a shared load balancer on the subnet",
     "call": {"method": "POST", "service": "elb", "path": "/v2.0/lbaas/loadbalancers",
              "body": {"loadbalancer": {"name": "${name}", "vip_subnet_id": "${neutron_subnet}"}}},
     "id_field": "loadbalancer.id",
     "name": "${name}",
     "find": {"call": {"method": "GET", "service": "elb", "path": "/v2.0/lbaas/loadbalancers", "query": {"name": "${name}"}},
              "list": "loadbalancers", "field": "id", "within": 60},
     "resource": {"kind": "elb", "type": "elb shared load balancer", "cost": "small"},
     "tags": "name",
     "confirm": "the key service sends an AK/SK-signed call without the X-Project-Id header the lease check sent with its token; whether ELB v2.0 takes it so; the find GET /v2.0/lbaas/loadbalancers with the name filter and the list under loadbalancers"},
    {"id": "lb-active", "do": "wait", "says": "the load balancer is ACTIVE",
     "call": {"method": "GET", "service": "elb", "path": "/v2.0/lbaas/loadbalancers/${lb}"},
     "until": {"field": "loadbalancer.provisioning_status", "equals": "ACTIVE"}, "fail_on": ["ERROR"],
     "within": 180, "every": 5},
    {"id": "listener", "do": "create", "says": "a listener on the port",
     "call": {"method": "POST", "service": "elb", "path": "/v2.0/lbaas/listeners",
              "body": {"listener": {"name": "${name}", "loadbalancer_id": "${lb}", "protocol": "${protocol}",
                                    "protocol_port": "${int:port}"}}},
     "id_field": "listener.id",
     "name": "${name}",
     "find": {"call": {"method": "GET", "service": "elb", "path": "/v2.0/lbaas/listeners", "query": {"name": "${name}"}},
              "list": "listeners", "field": "id", "within": 60},
     "resource": {"kind": "lsn", "type": "elb listener", "cost": "none"},
     "tags": "name",
     "confirm": "POST /v2.0/lbaas/listeners and its body; the find GET /v2.0/lbaas/listeners with the name filter and the list under listeners"},
    {"id": "lb-ready-1", "do": "wait", "says": "the load balancer takes the next change",
     "call": {"method": "GET", "service": "elb", "path": "/v2.0/lbaas/loadbalancers/${lb}"},
     "until": {"field": "loadbalancer.provisioning_status", "equals": "ACTIVE"}, "fail_on": ["ERROR"],
     "within": 120, "every": 5},
    {"id": "pool", "do": "create", "says": "a backend pool of the listener",
     "call": {"method": "POST", "service": "elb", "path": "/v2.0/lbaas/pools",
              "body": {"pool": {"name": "${name}", "listener_id": "${listener}", "protocol": "${protocol}",
                                "lb_algorithm": "ROUND_ROBIN"}}},
     "id_field": "pool.id",
     "name": "${name}",
     "find": {"call": {"method": "GET", "service": "elb", "path": "/v2.0/lbaas/pools", "query": {"name": "${name}"}},
              "list": "pools", "field": "id", "within": 60},
     "resource": {"kind": "pool", "type": "elb backend pool", "cost": "none"},
     "tags": "name",
     "confirm": "POST /v2.0/lbaas/pools and its body; the find GET /v2.0/lbaas/pools with the name filter and the list under pools"},
    {"id": "lb-ready-2", "do": "wait", "says": "the load balancer takes the next change",
     "call": {"method": "GET", "service": "elb", "path": "/v2.0/lbaas/loadbalancers/${lb}"},
     "until": {"field": "loadbalancer.provisioning_status", "equals": "ACTIVE"}, "fail_on": ["ERROR"],
     "within": 120, "every": 5},
    {"id": "member", "do": "create", "says": "the backend as a member of the pool",
     "call": {"method": "POST", "service": "elb", "path": "/v2.0/lbaas/pools/${pool}/members",
              "body": {"member": {"name": "${name}", "address": "${backend_ip}", "protocol_port": "${int:port}",
                                  "subnet_id": "${neutron_subnet}"}}},
     "id_field": "member.id",
     "name": "${name}",
     "find": {"call": {"method": "GET", "service": "elb", "path": "/v2.0/lbaas/pools/${pool}/members", "query": {"name": "${name}"}},
              "list": "members", "field": "id", "within": 60},
     "resource": {"kind": "mem", "type": "elb pool member", "cost": "none"},
     "tags": "name",
     "confirm": "POST /v2.0/lbaas/pools/ID/members and its body; the find GET /v2.0/lbaas/pools/ID/members with the name filter and the list under members"},
    {"id": "lb-ready-3", "do": "wait", "says": "the load balancer takes the next change",
     "call": {"method": "GET", "service": "elb", "path": "/v2.0/lbaas/loadbalancers/${lb}"},
     "until": {"field": "loadbalancer.provisioning_status", "equals": "ACTIVE"}, "fail_on": ["ERROR"],
     "within": 120, "every": 5},
    {"id": "monitor", "do": "create", "says": "a health monitor of the pool",
     "call": {"method": "POST", "service": "elb", "path": "/v2.0/lbaas/healthmonitors",
              "body": {"healthmonitor": {"name": "${name}", "pool_id": "${pool}", "type": "${hm_type}",
                                         "delay": 5, "timeout": 3, "max_retries": 3}}},
     "id_field": "healthmonitor.id",
     "name": "${name}",
     "find": {"call": {"method": "GET", "service": "elb", "path": "/v2.0/lbaas/healthmonitors", "query": {"name": "${name}"}},
              "list": "healthmonitors", "field": "id", "within": 60},
     "resource": {"kind": "hm", "type": "elb health monitor", "cost": "none"},
     "tags": "name",
     "confirm": "POST /v2.0/lbaas/healthmonitors and its body; the find GET /v2.0/lbaas/healthmonitors with the name filter and the list under healthmonitors"},
    {"id": "healthy", "do": "wait", "says": "the member passes its health check",
     "call": {"method": "GET", "service": "elb", "path": "/v2.0/lbaas/pools/${pool}/members/${member}"},
     "until": {"field": "member.operating_status", "equals": "ONLINE"}, "within": 300, "every": 10,
     "confirm": "GET /v2.0/lbaas/pools/ID/members/ID and member.operating_status ONLINE"}
  ],
  "checks": [
    {"id": "image-known", "step": "image", "says": "the image is known in the region", "field": "images.0.id", "present": true},
    {"id": "backend-boots", "step": "boot", "says": "the backend reaches ACTIVE within 10 minutes", "reached": true},
    {"id": "health-passes", "step": "healthy", "says": "the member reads ONLINE within 5 minutes", "reached": true}
  ],
  "teardown": {
    "vpc": {"call": {"method": "DELETE", "service": "vpc", "path": "/v1/{project_id}/vpcs/${id}"},
            "gone": {"call": {"method": "GET", "service": "vpc", "path": "/v1/{project_id}/vpcs/${id}"}, "status": [404]}},
    "subnet": {"call": {"method": "DELETE", "service": "vpc", "path": "/v1/{project_id}/vpcs/${vpc}/subnets/${id}"},
               "gone": {"call": {"method": "GET", "service": "vpc", "path": "/v1/{project_id}/subnets/${id}"}, "status": [404]}},
    "sg": {"call": {"method": "DELETE", "service": "vpc", "path": "/v1/{project_id}/security-groups/${id}"},
           "gone": {"call": {"method": "GET", "service": "vpc", "path": "/v1/{project_id}/security-groups/${id}"}, "status": [404]},
           "confirm": "DELETE and GET /v1/{project_id}/security-groups/ID"},
    "backend": {"call": {"method": "POST", "service": "ecs", "path": "/v1/{project_id}/cloudservers/delete",
                         "body": {"servers": [{"id": "${id}"}], "delete_publicip": true, "delete_volume": true}},
                "gone": {"call": {"method": "GET", "service": "ecs", "path": "/v1/{project_id}/cloudservers/${id}"},
                         "status": [404], "field": "server.status", "in": ["DELETED"], "within": 300},
                "confirm": "POST /v1/{project_id}/cloudservers/delete with delete_volume"},
    "lb": {"call": {"method": "DELETE", "service": "elb", "path": "/v2.0/lbaas/loadbalancers/${id}"},
           "gone": {"call": {"method": "GET", "service": "elb", "path": "/v2.0/lbaas/loadbalancers/${id}"}, "status": [404]}},
    "listener": {"call": {"method": "DELETE", "service": "elb", "path": "/v2.0/lbaas/listeners/${id}"},
                 "gone": {"call": {"method": "GET", "service": "elb", "path": "/v2.0/lbaas/listeners/${id}"}, "status": [404]},
                 "confirm": "DELETE and GET /v2.0/lbaas/listeners/ID; a delete while the load balancer is busy answers 409 and is tried again"},
    "pool": {"call": {"method": "DELETE", "service": "elb", "path": "/v2.0/lbaas/pools/${id}"},
             "gone": {"call": {"method": "GET", "service": "elb", "path": "/v2.0/lbaas/pools/${id}"}, "status": [404]},
             "confirm": "DELETE and GET /v2.0/lbaas/pools/ID"},
    "member": {"call": {"method": "DELETE", "service": "elb", "path": "/v2.0/lbaas/pools/${pool}/members/${id}"},
               "gone": {"call": {"method": "GET", "service": "elb", "path": "/v2.0/lbaas/pools/${pool}/members/${id}"}, "status": [404]},
               "confirm": "DELETE and GET /v2.0/lbaas/pools/ID/members/ID"},
    "monitor": {"call": {"method": "DELETE", "service": "elb", "path": "/v2.0/lbaas/healthmonitors/${id}"},
                "gone": {"call": {"method": "GET", "service": "elb", "path": "/v2.0/lbaas/healthmonitors/${id}"}, "status": [404]},
                "confirm": "DELETE and GET /v2.0/lbaas/healthmonitors/ID"}
  },
  "kb": {"scope": "tcp", "tags": ["elb", "ecs"], "class": "api",
         "statement": "A shared ELB in ${region} with an ${protocol} listener on port ${port}, a ROUND_ROBIN pool and an ${hm_type} health monitor marks an ECS backend ONLINE when the backend's security group lets the port in from the address range of the ELB health checks."}
}
