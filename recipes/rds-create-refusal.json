{
  "name": "rds-create-refusal",
  "question": "Does RDS for SQL Server ${version} in ${region} refuse a create with the collation ${collation} the way it refuses an invented collation, with nothing made?",
  "about": "A VPC with a subnet and a security group, then two SQL Server creates with the same body where only the collation differs: first the collation under test, then the invented control Awb_No_Such_Collation_CI_AS. RDS answers a collation it does not take with HTTP 500 and DBS.200005 (the pilot of 2026-10-14), not 400, so each 500 is followed by the find by name, which must prove nothing was made. The checks: the tested value gets the answer of the control (HTTP 500, the error codes of both stand in the evidence) and the instance list holds as many instances after as before. A create that is accepted (202) gets its row at once and fails the check: the value is taken. It builds for about 26 minutes and refuses its delete while it builds (409 DBS.200019), so the teardown repeats the delete until it is taken and proves it gone by the read by id (total 0) and the recycle bin (total 0), all within the 30 minutes of the cap. The admin password is a throw-away value.",
  "params": {
    "collation": {"default": "Latin1_General_100_CI_AS_SC_UTF8", "pattern": "^[A-Za-z0-9_]{3,80}$",
                  "help": "the collation under test"},
    "version": {"default": "2019_SE", "pattern": "^20[0-9]{2}_(SE|EE|WEB)$",
                "help": "the SQL Server version of the datastore"},
    "flavor": {"default": "rds.mssql.se.s3.large.2", "pattern": "^rds\\.mssql\\.[a-z0-9.]{3,40}$",
               "help": "the spec code of the instance; the deny list refuses large.8 and above"},
    "region": {"default": "eu-de", "pattern": "^eu-(de|nl)$"},
    "az": {"default": "eu-de-01", "pattern": "^eu-(de|nl)-0[1-3]$"}
  },
  "vars": {
    "cidr": "192.168.10.0/24",
    "control_collation": "Awb_No_Such_Collation_CI_AS"
  },
  "budget": {"minutes": 3, "teardown_minutes": 27},
  "guard": {"resources": 5, "lifetime_minutes": 30},
  "steps": [
    {"id": "vpc", "do": "create", "says": "a VPC",
     "call": {"method": "POST", "service": "vpc", "path": "/v1/{project_id}/vpcs",
              "body": {"vpc": {"name": "${name}", "cidr": "192.168.0.0/16"}}},
     "id_field": "vpc.id",
     "name": "${name}",
     "find": {"call": {"method": "GET", "service": "vpc", "path": "/v1/{project_id}/vpcs", "query": {"limit": "100"}},
              "list": "vpcs", "field": "id", "within": 60},
     "resource": {"kind": "vpc", "type": "vpc", "cost": "none"},
     "tags": {"method": "POST", "service": "vpc", "path": "/v2.0/{project_id}/vpcs/${id}/tags/action",
              "body": {"action": "create", "tags": "${tags:kv}"}},
     "confirm": "the tag call POST /v2.0/{project_id}/vpcs/ID/tags/action, as in ecs-boot-ssh"},
    {"id": "subnet", "do": "create", "says": "a subnet in the VPC",
     "call": {"method": "POST", "service": "vpc", "path": "/v1/{project_id}/subnets",
              "body": {"subnet": {"name": "${name}", "cidr": "${cidr}", "gateway_ip": "192.168.10.1",
                                  "vpc_id": "${vpc}", "availability_zone": "${az}", "dhcp_enable": true}}},
     "id_field": "subnet.id",
     "name": "${name}",
     "find": {"call": {"method": "GET", "service": "vpc", "path": "/v1/{project_id}/subnets", "query": {"vpc_id": "${vpc}"}},
              "list": "subnets", "field": "id", "within": 60},
     "resource": {"kind": "sub", "type": "vpc subnet", "cost": "none"},
     "tags": "name",
     "confirm": "the find GET /v1/{project_id}/subnets with the vpc_id filter, as in ecs-boot-ssh"},
    {"id": "subnet-active", "do": "wait", "says": "the subnet is ACTIVE",
     "call": {"method": "GET", "service": "vpc", "path": "/v1/{project_id}/subnets/${subnet}"},
     "until": {"field": "subnet.status", "equals": "ACTIVE"}, "fail_on": ["ERROR"], "within": 90, "every": 5},
    {"id": "sg", "do": "create", "says": "a security group in the VPC",
     "call": {"method": "POST", "service": "vpc", "path": "/v1/{project_id}/security-groups",
              "body": {"security_group": {"name": "${name}", "vpc_id": "${vpc}"}}},
     "id_field": "security_group.id",
     "name": "${name}",
     "find": {"call": {"method": "GET", "service": "vpc", "path": "/v1/{project_id}/security-groups", "query": {"vpc_id": "${vpc}"}},
              "list": "security_groups", "field": "id", "within": 60},
     "resource": {"kind": "sg", "type": "security group", "cost": "none"},
     "tags": "name",
     "confirm": "POST and the find of /v1/{project_id}/security-groups, as in ecs-boot-ssh"},
    {"id": "count-before", "do": "call", "says": "count the RDS instances before the creates",
     "call": {"method": "GET", "service": "rds", "path": "/v3/{project_id}/instances"},
     "save": {"count_before": "total_count"},
     "confirm": "GET /v3/{project_id}/instances and the count under total_count"},
    {"id": "tested", "do": "create", "says": "the create with the collation under test",
     "call": {"method": "POST", "service": "rds", "path": "/v3/{project_id}/instances",
              "body": {"name": "${name}-t", "datastore": {"type": "SQLServer", "version": "${version}"},
                       "flavor_ref": "${flavor}", "volume": {"type": "ULTRAHIGH", "size": 40},
                       "region": "${region}", "availability_zone": "${az}", "vpc_id": "${vpc}",
                       "subnet_id": "${subnet}", "security_group_id": "${sg}", "password": "{{random:password}}",
                       "collation": "${collation}", "tags": "${tags:kv}"}},
     "id_field": "instance.id",
     "name": "${name}-t",
     "find": {"call": {"method": "GET", "service": "rds", "path": "/v3/{project_id}/instances", "query": {"name": "${name}-t"}},
              "list": "instances", "field": "id", "within": 30},
     "resource": {"kind": "rds", "type": "rds sql server instance", "cost": "medium"},
     "tags": "body",
     "confirm": "the create body of the RDS v3 API for SQL Server (the body of the pilot was not kept): datastore, flavor_ref, volume, collation and tags; the id under instance.id of a 202; the find GET /v3/{project_id}/instances with the name filter and the list under instances"},
    {"id": "control", "do": "create", "says": "the same create with the invented collation as the control",
     "call": {"method": "POST", "service": "rds", "path": "/v3/{project_id}/instances",
              "body": {"name": "${name}-c", "datastore": {"type": "SQLServer", "version": "${version}"},
                       "flavor_ref": "${flavor}", "volume": {"type": "ULTRAHIGH", "size": 40},
                       "region": "${region}", "availability_zone": "${az}", "vpc_id": "${vpc}",
                       "subnet_id": "${subnet}", "security_group_id": "${sg}", "password": "{{random:password}}",
                       "collation": "${control_collation}", "tags": "${tags:kv}"}},
     "id_field": "instance.id",
     "name": "${name}-c",
     "find": {"call": {"method": "GET", "service": "rds", "path": "/v3/{project_id}/instances", "query": {"name": "${name}-c"}},
              "list": "instances", "field": "id", "within": 30},
     "resource": {"kind": "rds", "type": "rds sql server instance", "cost": "medium"},
     "tags": "body",
     "confirm": "as for the tested create"},
    {"id": "count-after", "do": "call", "says": "count the RDS instances after the creates",
     "call": {"method": "GET", "service": "rds", "path": "/v3/{project_id}/instances"}}
  ],
  "checks": [
    {"id": "tested-refused", "step": "tested", "says": "the collation under test is refused with HTTP 500, the answer of the control (an accepted create means the value is taken)", "status": [500]},
    {"id": "control-refused", "step": "control", "says": "the invented collation is refused with HTTP 500", "status": [500]},
    {"id": "nothing-made", "step": "count-after", "says": "the instance list holds as many instances as before", "field": "total_count", "equals": "${int:count_before}"}
  ],
  "teardown": {
    "vpc": {"call": {"method": "DELETE", "service": "vpc", "path": "/v1/{project_id}/vpcs/${id}"},
            "gone": {"call": {"method": "GET", "service": "vpc", "path": "/v1/{project_id}/vpcs/${id}"}, "status": [404]},
            "confirm": "a VPC delete may answer 409 VPC.0104 while its subnet is still going; the teardown repeats the delete until it is taken"},
    "subnet": {"call": {"method": "DELETE", "service": "vpc", "path": "/v1/{project_id}/vpcs/${vpc}/subnets/${id}"},
               "gone": {"call": {"method": "GET", "service": "vpc", "path": "/v1/{project_id}/subnets/${id}"}, "status": [404]}},
    "sg": {"call": {"method": "DELETE", "service": "vpc", "path": "/v1/{project_id}/security-groups/${id}"},
           "gone": {"call": {"method": "GET", "service": "vpc", "path": "/v1/{project_id}/security-groups/${id}"}, "status": [404]},
           "confirm": "DELETE and GET /v1/{project_id}/security-groups/ID"},
    "tested": {"call": {"method": "DELETE", "service": "rds", "path": "/v3/{project_id}/instances/${id}"},
               "gone": {"call": {"method": "GET", "service": "rds", "path": "/v3/{project_id}/instances", "query": {"id": "${id}"}},
                        "field": "total_count", "in": [0], "within": 1500,
                        "also": {"call": {"method": "GET", "service": "rds", "path": "/v3/{project_id}/recycle-instances"},
                                 "field": "total_count", "in": [0]}},
               "confirm": "an instance that builds refuses its delete with 409 DBS.200019 for about 26 minutes, the teardown repeats the delete every 10 s until it is taken; gone is the read by id with total_count 0 and the recycle bin GET /v3/{project_id}/recycle-instances with total_count 0"},
    "control": {"call": {"method": "DELETE", "service": "rds", "path": "/v3/{project_id}/instances/${id}"},
                "gone": {"call": {"method": "GET", "service": "rds", "path": "/v3/{project_id}/instances", "query": {"id": "${id}"}},
                         "field": "total_count", "in": [0], "within": 1500,
                         "also": {"call": {"method": "GET", "service": "rds", "path": "/v3/{project_id}/recycle-instances"},
                                  "field": "total_count", "in": [0]}},
                "confirm": "as for the tested create"}
  },
  "kb": {"scope": "tcp", "tags": ["rds", "rds-mssql"], "class": "api",
         "statement": "RDS for SQL Server ${version} in ${region} refuses a create with the collation ${collation} the way it refuses an invented collation: HTTP 500 and not 400, with nothing made."}
}
