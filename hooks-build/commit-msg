#!/bin/sh
# The commit message gate of a build clone (presentations/self-build), installed with the release as
# /opt/tcp-awb/src/hooks-build. The installed gate by the installed interpreter's absolute path. A build clone is
# inside: the message runs no content check (--inside); an assistant named as co-author refuses the message git gives
# as $1. The names, secrets and paths are checked where the commits leave, by the runner's push of main.

python=/opt/tcp-awb/venv/bin/python3
msg="$1"
top=$(git rev-parse --show-toplevel) || exit 2
cd "$top" || exit 2
if ! "$python" -I -B -m awb gate --selftest --no-register >/dev/null 2>&1; then
    echo "awb gate: commit refused, the gate failed its self-test and cannot be trusted to find anything." >&2
    exit 1
fi
"$python" -I -B -m awb gate --message "$msg" --inside --no-register
code=$?
if [ "$code" -ne 0 ]; then
    echo "awb gate: commit refused (exit code $code), the commit message names an assistant as co-author." >&2
fi
exit "$code"
