{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/awb hook prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/awb hook pre-write"
          }
        ]
      },
      {
        "matcher": "Read|Edit|MultiEdit|NotebookEdit|Write|Glob|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/awb hook pre-tool"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/awb hook post-write"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/awb hook stop"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/awb hook session-start"
          }
        ]
      }
    ]
  }
}
