# The Ask page of the Architect Workbench (awb/tcp/ask.py). It runs as its own service user awb-ask, which alone reads
# the API key (/etc/awb/anthropic.key, mode 400): the work user's sessions never see it. Group awb lets it read the
# knowledge base and the tenant snapshots and reach the check socket. 127.0.0.1 only, behind the tunnel's access check.
[Unit]
Description=Architect Workbench Ask page
After=network-online.target awb-vaultd.service

[Service]
Type=simple
User=awb-ask
Group=awb
Environment=AWB_CONF=/etc/awb/paths.conf
Environment=AWB_ASK_USAGE=/var/lib/awb-ask/usage.json
StateDirectory=awb-ask
StateDirectoryMode=0700
ExecStart=/usr/local/bin/awb ask serve --port 8081
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
LimitCORE=0

[Install]
WantedBy=multi-user.target
