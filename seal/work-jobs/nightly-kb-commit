#!/bin/sh
# Nightly commit of the knowledge base as the work user (01:40 UTC, timer of seal/setup.sh): what the sessions added
# during the day goes in through the commit hook of the knowledge base (the gate and awb kb verify --staged). The
# name check allows 600 checks a minute per user, so the files go in batches of BATCH with a pause between them; a
# batch the hook refuses is left for the next night and the next batch goes on. The run stops after MAX_BATCHES.
# Log: ~/.local/state/kb-commit.log
PATH=/usr/local/bin:/usr/bin:/bin; export PATH
BATCH=${BATCH:-25}; PAUSE=${PAUSE:-70}; MAX_BATCHES=${MAX_BATCHES:-40}
log="$HOME/.local/state/kb-commit.log"
{
    echo "== $(date -u "+%Y-%m-%d %H:%M:%S") UTC"
    cd "$HOME/tcp-kb" || exit 1
    git reset -q
    files=$(git status --porcelain --untracked-files=all -- entries | awk '{print $NF}')
    if [ -z "$files" ]; then
        echo "nothing to commit"
        exit 0
    fi
    n=0; done_=0; refused=0
    printf '%s\n' "$files" | split -l "$BATCH" - /tmp/kb-commit-batch.$$.
    for b in /tmp/kb-commit-batch.$$.*; do
        n=$((n + 1))
        [ "$n" -gt "$MAX_BATCHES" ] && { echo "stopped after $MAX_BATCHES batches"; break; }
        [ "$n" -gt 1 ] && sleep "$PAUSE"
        xargs git add -A -- < "$b"
        if git commit -q -m "Knowledge of $(date -u +%Y-%m-%d): batch $n"; then
            done_=$((done_ + $(wc -l < "$b")))
        else
            refused=$((refused + $(wc -l < "$b")))
            git reset -q
        fi
    done
    rm -f /tmp/kb-commit-batch.$$.*
    awb kb index >/dev/null && git add INDEX.md && git commit -q -m "Knowledge of $(date -u +%Y-%m-%d): index" 2>/dev/null
    echo "committed $done_ files, refused $refused (left for the next night)"
} >>"$log" 2>&1
