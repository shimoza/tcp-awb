# The weekly read tier of the fact-check (design F9), rendered by seal/setup.sh with the work home. It runs
# awb kb recheck-run --tier read as the work user, never the write tier: a read tier sends GET calls with the read
# key over the key service's sockets, so no address family but unix. A run needs a tenant: the unit names none, awb
# takes recheck_tenant of the host file, which the owner sets (verify.sh warns without it). It writes the knowledge
# base, the evidence of the service project and the recheck state.tsv, all in the work home. After= the nightly kb commit: systemd orders
# the two when both start at once (the commit runs at 01:40, the recheck Saturday 19:00 UTC).
[Unit]
Description=Architect Workbench weekly fact-check of the knowledge base, read tier
After=awb-kb-commit.service

[Service]
Type=oneshot
User=awb
Group=awb
WorkingDirectory=@WORK_HOME@
ExecStart=/usr/local/bin/awb kb recheck-run --tier read
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@WORK_HOME@
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
LimitCORE=0
TimeoutStartSec=1h
