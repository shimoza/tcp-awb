# The timer of awb-kb-recheck.service: Saturday 19:00 UTC (20:00 Berlin in winter), the owner's decision of 2026-10-28
# (his token allowance renews Sunday 02:00, so the run spends what the week left on Saturday evening; it replaces D1
# of the fact-check design, Sunday 02:30 UTC), up to 15 minutes later at random. A missed run is not made up at boot.
# Installed and enabled by seal/setup.sh.
[Unit]
Description=Architect Workbench weekly fact-check of the knowledge base, read tier, Saturday 19:00 UTC

[Timer]
OnCalendar=Sat *-*-* 19:00:00 UTC
RandomizedDelaySec=15min
Persistent=false
Unit=awb-kb-recheck.service

[Install]
WantedBy=timers.target
