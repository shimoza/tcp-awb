# Template of the web side of the Workbench (seal/web/README.md). Placeholders: @OWNER@ the owner user,
# @DOMAIN@ the host name of the site, @VAULT@ and @SHARED@ the folders of /etc/awb/paths.conf, @WORK_HOME@ the
# home of the work user. Not installed by setup.sh: the switch is a step of its own.
[Unit]
Description=AWB work user project creation adapter
Requires=awb-project-create.socket
After=awb-vaultd.service
[Service]
User=awb
Group=awb
Environment=AWB_CONF=/etc/awb/paths.conf
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/tcp-awb/venv/bin/python3 -I -m awb.tcp.web.create_api projects --state /var/lib/awb-project-write --owner @OWNER@
StateDirectory=awb-project-write
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@WORK_HOME@
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
UMask=0077
LimitCORE=0
TasksMax=64
MemoryMax=256M
