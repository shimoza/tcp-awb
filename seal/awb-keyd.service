# The key service of the Architect Workbench (awb/tcp/keys.py). It runs as the owner like the vault daemon and holds
# the keys and secrets of the test tenants in memory only: after every start the owner loads them with awb keys
# unlock. The call socket /run/awb-keys/cloud.sock is reachable by the group awb, the admin socket stays in the
# owner's vault. Installed by seal/setup.sh, which fills in the owner's user name in the User line.
[Unit]
Description=Architect Workbench key service
After=network-online.target

[Service]
# Type=notify: the key service says READY=1 once its sockets are bound. A reload (awb deploy after a code update, or
# systemctl reload by hand) runs ExecReload: the key service starts its successor from the installed code, hands it
# the sockets and what it holds over a private socket pair and names it with MAINPID; the journal then shows
# "Supervising process N which is not our child" once per reload, as expected. A stop, a crash or a reboot still
# forget everything held in memory.
Type=notify
NotifyAccess=main
ExecReload=/usr/local/bin/awb keys reload
TimeoutStartSec=120
User=@OWNER@
Group=awb
RuntimeDirectory=awb-keys
RuntimeDirectoryMode=0750
Environment=AWB_CONF=/etc/awb/paths.conf
ExecStart=/usr/local/bin/awb keys serve
Restart=on-failure
RestartSec=5
UMask=0007
# no core dump: the keys live in the service's memory
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
