# The vault daemon of the Architect Workbench. Installed by seal/setup.sh, which fills in the owner's user name
# in the User line. It runs as the owner (who keeps the vault) with the group awb: the check socket in /run/awb is
# then reachable by the work user and nobody else, the admin socket stays inside the owner's vault.
[Unit]
Description=Architect Workbench vault daemon
After=local-fs.target

[Service]
# Type=notify: the vault daemon says READY=1 once its sockets are bound. A reload (awb deploy after a code update, or
# systemctl reload by hand) runs ExecReload: the vault daemon starts its successor from the installed code, hands it
# the sockets and what it holds over a private socket pair and names it with MAINPID; the journal then shows
# "Supervising process N which is not our child" once per reload, as expected. A stop, a crash or a reboot still
# forget everything held in memory.
Type=notify
NotifyAccess=main
ExecReload=/usr/local/bin/awb vault reload
TimeoutStartSec=120
User=@OWNER@
Group=awb
RuntimeDirectory=awb
RuntimeDirectoryMode=0750
Environment=AWB_CONF=/etc/awb/paths.conf
ExecStart=/usr/local/bin/awb vault serve
Restart=on-failure
RestartSec=5
UMask=0077
# no core dump: the passphrase and the decrypted register live in the daemon's memory
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
